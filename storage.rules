rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /system-card-headers/{systemId}/{fileName} {
      allow read: if request.auth != null;
      allow delete: if request.auth != null;
      allow create, update: if request.auth != null
        && fileName == 'header'
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/(png|webp)');
    }

    match /module-images/{moduleId}/{fileName} {
      allow read, delete: if request.auth != null;
      allow create, update: if request.auth != null
        && fileName == 'cover'
        && request.resource.size < 5 * 1024 * 1024
        && (request.resource.contentType == 'image/png'
          || request.resource.contentType == 'image/jpeg'
          || request.resource.contentType == 'image/webp'
          || request.resource.contentType == 'image/svg+xml');
    }
  }
}
